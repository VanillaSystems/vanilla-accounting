{
  "name": "vanilla-accounting",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "concurrently --names \"vite,api\" --prefix-colors \"cyan,green\" \"vite\" \"tsx src/server/main.ts\"",
    "start:audit": "concurrently --names \"vite,api\" --prefix-colors \"cyan,green\" \"vite --host\" \"READONLY=1 tsx src/server/main.ts\"",
    "dev": "vite",
    "dev:full": "concurrently --names \"vite,api\" --prefix-colors \"cyan,green\" \"vite\" \"tsx src/server/main.ts\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "init": "tsx src/cli/init.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "extract": "tsx src/cli/extract.ts",
    "extract-vat": "tsx src/cli/extract-vat.ts",
    "match": "tsx src/cli/match.ts",
    "rename": "tsx src/cli/rename.ts",
    "classify": "tsx src/cli/classify.ts",
    "rebook-shopify": "tsx src/cli/rebook-shopify-orders.ts",
    "reconcile": "tsx src/cli/reconcile.ts",
    "export": "tsx src/cli/export.ts",
    "collect": "tsx src/collect/download-attachments.ts",
    "collect-links": "tsx src/collect/extract-links.ts",
    "collect-missed": "tsx src/collect/find-missed-pdfs.ts",
    "import-opening": "tsx src/cli/import-opening-balances.ts",
    "vat-report": "tsx src/cli/vat-report.ts",
    "vat-report-html": "tsx src/cli/vat-report-html.ts",
    "vat-xml": "tsx src/cli/vat-ech0217.ts",
    "fetch-rates": "tsx src/cli/fetch-estv-rates.ts",
    "restamp-fx": "tsx src/cli/restamp-fx-rates.ts",
    "reconcile-balances": "tsx src/cli/reconcile-balances.ts",
    "check-closed": "tsx src/cli/check-closed-period.ts",
    "board": "tsx src/cli/import-board.ts",
    "extract-balances": "tsx src/cli/extract-statement-balances.ts",
    "check-processes": "tsx src/cli/check-processes.ts",
    "migrate-workspace": "tsx src/cli/migrate-workspace.ts",
    "check-public": "tsx src/cli/check-public.ts",
    "export-public": "tsx src/cli/export-public.ts",
    "llm-usage": "tsx src/cli/llm-usage.ts",
    "extract-shopify-orders": "tsx src/cli/extract-shopify-orders.ts",
    "evidence": "tsx src/cli/evidence.ts",
    "gaps": "tsx src/cli/gaps.ts",
    "demo:generate": "tsx tools/demo/generate.ts",
    "tutti": "tsx src/collect/tutti.ts",
    "pretest": "tsc --noEmit",
    "test": "VANILLA_WORKSPACE=demo node --import tsx --test \"tests/**/*.test.ts\" && VANILLA_WORKSPACE=demo-consulting node --import tsx --test tests/vat-golden.test.ts tests/classify-force.test.ts",
    "test:update": "VANILLA_WORKSPACE=demo UPDATE_GOLDEN=1 node --import tsx --test tests/vat-golden.test.ts tests/classify-force.test.ts && VANILLA_WORKSPACE=demo-consulting UPDATE_GOLDEN=1 node --import tsx --test tests/vat-golden.test.ts tests/classify-force.test.ts",
    "test:freeze": "VANILLA_WORKSPACE=demo tsx tests/support/freeze-books.ts && VANILLA_WORKSPACE=demo-consulting tsx tests/support/freeze-books.ts",
    "test:books": "node --env-file-if-exists=.env --import tsx --test tests/vat-golden.test.ts tests/classify-force.test.ts",
    "test:books:update": "UPDATE_GOLDEN=1 node --env-file-if-exists=.env --import tsx --test tests/vat-golden.test.ts tests/classify-force.test.ts",
    "test:books:freeze": "tsx --env-file-if-exists=.env tests/support/freeze-books.ts",
    "mine-cases": "tsx tools/cases/mine.ts"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "bonjour-service": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^4.5.1",
    "imapflow": "^1.4.2",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/bonjour": "^3.5.13",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "yaml": "^2.9.1"
  }
}
