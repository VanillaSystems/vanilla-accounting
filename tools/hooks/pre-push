#!/bin/sh
# Refuses a push while the leak guard finds company data in the app's public files,
# or while the layers lint (tests/layers.test.ts) finds a Swiss-specific name outside modules/ch and src/providers.
# Install once per clone: git config core.hooksPath tools/hooks
# The secrets come from the workspace (VANILLA_WORKSPACE, or the repo itself while it is one);
# without a real workspace only the structural half runs, and says so.
npm run --silent check-public || exit 1
node --import tsx --test tests/layers.test.ts || {
  echo "pre-push: the layers lint failed (message above); fix it before pushing." >&2
  exit 1
}
