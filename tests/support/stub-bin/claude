#!/usr/bin/env node
// Stands in for the `claude` CLI that src/llm/ask.ts spawns, so a test runs the real code with
// no model call. A classify prompt gets one entry on 6570 per transaction, I81 when its section
// carries Swiss VAT facts. A VAT facts prompt gets STUB_VAT (no Swiss VAT). The vision prompt that
// reads a scan's text gets STUB_OCR_TEXT; any other prompt (a match, also one that reads the file)
// answers STUB_ANSWER (JSON), or $CLAUDE_STUB_ANSWER when set. `--version` answers at once.
// $CLAUDE_STUB_PROMPTS: each prompt is appended there.
// $CLAUDE_STUB_GATE: the stub appends a line to <gate>.started, then waits until <gate> exists.
import { appendFileSync, existsSync, readFileSync } from 'node:fs';

const STUB_OCR_TEXT = 'Stub-OCR\n\nBeleg vom Stub gelesen';
const STUB_VAT = { vatId: '', currency: 'CHF', hasSwissVat: false, vatSummary: [] };
const STUB_ANSWER = { suggestedFilename: '20260812-stub-shop.pdf', date: '2026-08-12', description: 'Stub Shop', amount: 50, currency: 'EUR' };

if (process.argv.includes('--version')) {
  process.stdout.write('0.0.0 (stub)\n');
  process.exit(0);
}

const prompt = readFileSync(0, 'utf8');
if (process.env.CLAUDE_STUB_PROMPTS) appendFileSync(process.env.CLAUDE_STUB_PROMPTS, prompt + '\n\0\n');
const gate = process.env.CLAUDE_STUB_GATE;
if (gate) {
  appendFileSync(`${gate}.started`, 'x\n');
  while (!existsSync(gate)) await new Promise((r) => setTimeout(r, 20));
}

function classify() {
  const answer = {};
  for (const section of prompt.split('## Chart of Accounts')[0].split(/^### Transaction \d+: /m).slice(1)) {
    const ref = section.split('\n')[0].trim();
    const amount = Number(section.match(/Amount: (-?[\d.]+) /)[1]);
    const vatCode = /VAT facts: Swiss MWST/.test(section) ? 'I81' : 'I0';
    answer[ref] = { entries: [{ accountDebit: '6570', accountCredit: '', amount, vatCode, description: 'Stub, Aufwand' }] };
  }
  return JSON.stringify(answer);
}

const result = prompt.includes('## Chart of Accounts') ? classify()
  : prompt.includes('Extract ONLY the VAT (MWST) facts') ? JSON.stringify(STUB_VAT)
  : prompt.includes('Extrahiere den vollständigen Text') ? STUB_OCR_TEXT
  : process.env.CLAUDE_STUB_ANSWER ?? JSON.stringify(STUB_ANSWER);
process.stdout.write(JSON.stringify({ result, is_error: false, usage: { input_tokens: 7, output_tokens: 3 }, num_turns: 1 }));
