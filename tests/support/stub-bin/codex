#!/usr/bin/env node
// Stands in for the `codex` CLI that src/llm/providers/codex-cli.ts runs (tests/codex-provider.test.ts).
// `codex login status` exits $CODEX_STUB_STATUS (0: signed in). `codex exec` reads the prompt on
// stdin and prints JSONL events as codex-cli 0.163 does; $CODEX_STUB_MODE picks the run:
// answer (default: $CODEX_STUB_ANSWER or {"stub":"codex"}), limit, signedOut, act (starts a command, or
// the item $CODEX_STUB_ITEM, and waits to be killed; in the KI column after an answer with the changes block). $CODEX_STUB_ARGS: each call's arguments, the prompt and the instructions
// file's text, the cwd and CODEX_HOME, one JSON line per call.
// A message of the KI column (src/assistant/codex.ts: `-c mcp_servers.vanilla.url=…`) calls the
// app's tools over MCP as listed in the file $CODEX_STUB_TOOLS ([{ tool, arguments }]), each as an
// mcp_tool_call item with the server's result, then answers «Stub-Codex auf «<last line>».» with the
// vanilla-changes block of the file $CODEX_STUB_CHANGES when it exists. `exec resume <id>` keeps <id>.
import { randomUUID } from 'node:crypto';
import { appendFileSync, existsSync, readFileSync } from 'node:fs';

const args = process.argv.slice(2);
if (args[0] === '--version') {
  process.stdout.write('codex-cli 0.163.0\n');
  process.exit(0);
}
if (args[0] === 'login' && args[1] === 'status') {
  process.stdout.write('Logged in using ChatGPT\n');
  process.exit(Number(process.env.CODEX_STUB_STATUS ?? 0));
}
// `codex debug models` prints the file $CODEX_STUB_MODELS (codex-cli 0.163's catalog JSON), else the
// bundled catalog of codex-cli 0.163; each run appends its CODEX_HOME as one line to $CODEX_STUB_DEBUG.
if (args[0] === 'debug' && args[1] === 'models') {
  if (process.env.CODEX_STUB_DEBUG) appendFileSync(process.env.CODEX_STUB_DEBUG, JSON.stringify({ home: process.env.CODEX_HOME }) + '\n');
  const listed = [['gpt-6-astra', 'list', 2], ['gpt-6.1-sol', 'list', 1], ['gpt-6-sol', 'list', 3], ['gpt-6-luna', 'list', 4], ['gpt-5.6-sol', 'list', 5],
    ['gpt-5.6-terra', 'list', 8], ['gpt-5.6-luna', 'list', 9], ['gpt-daybreak-blue-latest', 'hide', 11], ['gpt-5.5', 'list', 13], ['codex-auto-review', 'hide', 43]];
  process.stdout.write(process.env.CODEX_STUB_MODELS ? readFileSync(process.env.CODEX_STUB_MODELS, 'utf8')
    : JSON.stringify({ models: listed.map(([slug, visibility, priority]) => ({ slug, visibility, priority, input_modalities: ['text', 'image'] })) }));
  process.exit(0);
}

const prompt = readFileSync(0, 'utf8');
const file = args.find((a) => a.startsWith('model_instructions_file='))?.slice('model_instructions_file='.length);
const instructions = file ? readFileSync(JSON.parse(file), 'utf8') : undefined;
if (process.env.CODEX_STUB_ARGS) appendFileSync(process.env.CODEX_STUB_ARGS, JSON.stringify({ args, prompt, instructions, cwd: process.cwd(), home: process.env.CODEX_HOME }) + '\n');

const line = (o) => process.stdout.write(JSON.stringify(o) + '\n');
const mcp = args.find((a) => a.startsWith('mcp_servers.vanilla.url='))?.slice('mcp_servers.vanilla.url='.length);
const resumed = args[1] === 'resume' ? args.at(-2) : undefined;
line({ type: 'thread.started', thread_id: resumed ?? (mcp ? randomUUID() : '0199a213-81c0-7800-8aa1-bbab2a035a53') });
line({ type: 'turn.started' });
// $CODEX_STUB_CONTROL: a file with { mode, item } that overrides both, for a stub a server runs (its env is fixed).
const control = process.env.CODEX_STUB_CONTROL && existsSync(process.env.CODEX_STUB_CONTROL) ? JSON.parse(readFileSync(process.env.CODEX_STUB_CONTROL, 'utf8')) : {};
const mode = control.mode ?? process.env.CODEX_STUB_MODE ?? 'answer';
if (mode === 'limit') {
  line({ type: 'error', message: "You've hit your usage limit. Upgrade to Pro or try again at 6:00 PM." });
  line({ type: 'turn.failed', error: { message: "You've hit your usage limit. Upgrade to Pro or try again at 6:00 PM." } });
  process.exit(1);
}
// $CODEX_STUB_REFUSE: models the account refuses, comma-separated, as codex-cli 0.163 passes the API's refusal through.
const model = args[args.indexOf('--model') + 1];
if ((process.env.CODEX_STUB_REFUSE ?? '').split(',').includes(model)) {
  const said = JSON.stringify({ type: 'error', status: 400, error: { type: 'invalid_request_error', message: `The '${model}' model is not supported when using Codex with a ChatGPT account.`, code: 'model_not_found' } });
  line({ type: 'error', message: said });
  line({ type: 'turn.failed', error: { message: said } });
  process.exit(1);
}
if (mode === 'signedOut') {
  line({ type: 'error', message: 'unexpected status 401 Unauthorized: Not logged in' });
  process.exit(1);
}
if (mode === 'act') {
  // A KI column answer that names changes and then acts on its own: the app must end it and apply nothing.
  if (mcp && process.env.CODEX_STUB_CHANGES && existsSync(process.env.CODEX_STUB_CHANGES)) {
    line({ type: 'item.completed', item: { id: 'item_0', type: 'agent_message', text: `Erledigt.\n\n\`\`\`vanilla-changes\n${readFileSync(process.env.CODEX_STUB_CHANGES, 'utf8')}\n\`\`\`` } });
  }
  line({ type: 'item.started', item: control.item ?? (process.env.CODEX_STUB_ITEM ? JSON.parse(process.env.CODEX_STUB_ITEM) : undefined) ?? { id: 'item_1', type: 'command_execution', command: 'bash -lc ls ~', status: 'in_progress' } });
  setTimeout(() => process.exit(0), 30_000);
} else if (mcp) {
  const url = JSON.parse(mcp);
  let id = 0;
  const rpc = async (method, params) => {
    const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json, text/event-stream' }, body: JSON.stringify({ jsonrpc: '2.0', id: ++id, method, params }) });
    return (await res.json()).result;
  };
  await rpc('initialize', { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'codex-stub', version: '0' } });
  const listed = (await rpc('tools/list', {})).tools.map((t) => t.name);
  const calls = process.env.CODEX_STUB_TOOLS && existsSync(process.env.CODEX_STUB_TOOLS) ? JSON.parse(readFileSync(process.env.CODEX_STUB_TOOLS, 'utf8')) : [];
  for (const [i, c] of calls.entries()) {
    const item = { id: `item_t${i}`, type: 'mcp_tool_call', server: 'vanilla', tool: c.tool, arguments: c.arguments };
    line({ type: 'item.started', item: { ...item, status: 'in_progress' } });
    const result = await rpc('tools/call', { name: c.tool, arguments: c.arguments });
    line({ type: 'item.completed', item: { ...item, status: result.isError ? 'failed' : 'completed', result, error: null } });
  }
  const file = process.env.CODEX_STUB_CHANGES;
  const changes = file && existsSync(file) ? `\n\n\`\`\`vanilla-changes\n${readFileSync(file, 'utf8')}\n\`\`\`` : '';
  const asked = prompt.trim().split('\n').at(-1) ?? '';
  line({ type: 'item.completed', item: { id: 'item_a', type: 'agent_message', text: `Stub-Codex auf «${asked.trim()}». Werkzeuge: ${listed.join(', ')}. ${resumed ? 'Das Gespräch geht weiter.' : 'Ein neues Gespräch.'}${changes}` } });
  line({ type: 'turn.completed', usage: { input_tokens: 40, cached_input_tokens: 10, output_tokens: 9 } });
} else {
  line({ type: 'item.completed', item: { id: 'item_0', type: 'reasoning', text: 'thinking' } });
  line({ type: 'item.completed', item: { id: 'item_1', type: 'agent_message', text: `${process.env.CODEX_STUB_ANSWER ?? '{"stub":"codex"}'}\n` } });
  line({ type: 'turn.completed', usage: { input_tokens: 20, cached_input_tokens: 5, output_tokens: 7, reasoning_output_tokens: 3 } });
}
