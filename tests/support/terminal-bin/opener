#!/bin/sh
# Stands in for `open` (VANILLA_TERMINAL_OPENER): `-a <App> <script>` or `-na <App> --args -e <script>`
# (src/platform/terminal.ts openArgs). Writes the app to $TERMINAL_STUB_OUT.app and runs the script as the terminal would.
case "$1" in
  -a) app="$2"; script="$3" ;;
  -na) [ "$3" = --args ] && [ "$4" = -e ] || exit 2; app="$2"; script="$5" ;;
  *) exit 2 ;;
esac
if [ -n "$TERMINAL_STUB_OUT" ]; then printf %s "$app" > "$TERMINAL_STUB_OUT.app"; fi
exec /bin/sh "$script"
