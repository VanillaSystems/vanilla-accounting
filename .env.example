# Your company's workspace (directory with belege.workspace.yaml). Every npm script reads it from here.
# VANILLA_WORKSPACE=../my-company-books

# Receipt collection over IMAP: one set per mailbox in the workspace's mail.yaml, named by its `env` prefix.
# WORK_IMAP_USER=you@example.com
# WORK_IMAP_PASSWORD=app-specific-password
# WORK_IMAP_HOST=imap.example.com

# Chrome for the tutti chat PDFs, when it is not at the macOS default path.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# The password of the company's outgoing mailbox (Firma › E-Mail-Versand, outgoingMail in belege.workspace.yaml).
# VANILLA_SMTP_PASSWORD=app-specific-password

# AI provider keys (Firma › KI, issue #48) when this computer has no keychain the app can use. On a Mac
# the app keeps them in the keychain instead. The app never reads ANTHROPIC_API_KEY or OPENAI_API_KEY.
# VANILLA_ANTHROPIC_API_KEY=
# VANILLA_OPENAI_API_KEY=
